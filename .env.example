# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it is already listed in .gitignore.

# India Post MIS Reports portal
INDIAPOST_URL=https://app.indiapost.gov.in/misreports/crm-last-event
INDIAPOST_USERNAME=
INDIAPOST_PASSWORD=

# Default customer ID to run the report for (can be overridden with --customer-id)
INDIAPOST_CUSTOMER_ID=

# Where raw downloaded reports and processed output go
DOWNLOAD_DIR=./data/raw
PROCESSED_DIR=./data/processed

# Run the browser headed (visible) or headless. Use "false" (headed) the first
# few times, especially if the portal shows a CAPTCHA on login.
HEADLESS=true
